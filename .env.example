# Use your computer's LAN address for a physical device (for example http://192.168.1.20:8080).
EXPO_PUBLIC_API_URL=http://localhost:8080
EXPO_PUBLIC_WEB_URL=https://almonium.com

# The commit the bundle was built from, shown under Settings → About. CI sets it when it publishes
# an update; the bundle an EAS build ships with prints "bundled" instead. Leave it unset locally.
# EXPO_PUBLIC_GIT_SHA=

# Set to true to let a native build show membership prices and open almonium.com to buy or manage
# a plan. Leave it unset for store builds: Apple and Google only allow purchase links outside their
# billing on the United States storefront, and the app cannot tell storefronts apart yet. The web
# build ignores this and always links.
# EXPO_PUBLIC_EXTERNAL_PURCHASE_LINKS=true

# Public Stream Chat application key. Use the key of the Stream application that mints the
# streamChatToken on /users/me: zjh3fpuaexy2 for local and staging, gu8cqhq9nfsf for production.
EXPO_PUBLIC_STREAM_API_KEY=zjh3fpuaexy2

# Firebase web configuration is public client configuration, not an Admin SDK secret.
# These are the production project (`almonium`), which the local and production backends verify
# tokens against. The staging backend uses the `almonium-dev` project instead; get that set with
# `eas env:pull --environment preview`. Deployed builds never read this file: EAS builds and
# updates take their values from the EAS environment named in the eas.json profile.
EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyCotfh0KzDpP3HniEfxyxoAw9HUFAA8gFs
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=almonium.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=almonium
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=33380019461
EXPO_PUBLIC_FIREBASE_APP_ID=1:33380019461:web:6b4381869fdf5ec21ddb6c

# Create native OAuth clients in the existing Firebase project before enabling Google on device.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=33380019461-l4hq3eto00vvvgprtadahm5o2tqj65ti.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=33380019461-pcob2v5bj8ad1bh6s6kdvc502f1duuld.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=33380019461-7a32djn111mvp1d4fru66s86oolfnjjv.apps.googleusercontent.com
