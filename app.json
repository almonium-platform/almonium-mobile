{
  "expo": {
    "name": "Almonium",
    "slug": "almonium",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/almonium-logo.png",
    "scheme": "almonium",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.almonium.mobile",
      "usesAppleSignIn": true,
      "buildNumber": "1"
    },
    "android": {
      "package": "com.almonium.mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#F9F6F5",
        "foregroundImage": "./assets/images/almonium-logo.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/almonium-logo.png"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Almonium to access your photos so you can set a profile picture.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/almonium-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F9F6F5",
          "dark": {
            "backgroundColor": "#F9F6F5"
          }
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.33380019461-pcob2v5bj8ad1bh6s6kdvc502f1duuld"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "extraPods": [
              {
                "name": "GoogleUtilities",
                "modular_headers": true
              },
              {
                "name": "RecaptchaInterop",
                "modular_headers": true
              }
            ]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "db1f6412-0a43-442d-bdc6-b3de66f929c7"
      }
    },
    "owner": "almonium"
  }
}
