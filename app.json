{
  "expo": {
    "name": "Almonium",
    "slug": "almonium",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/almonium-logo.png",
    "scheme": "almonium",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.almonium.mobile",
      "usesAppleSignIn": true,
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "associatedDomains": [
        "applinks:almonium.com"
      ]
    },
    "android": {
      "package": "com.almonium.mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#F9F6F5",
        "foregroundImage": "./assets/images/almonium-logo.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "almonium.com",
              "pathPrefix": "/c/"
            },
            {
              "scheme": "https",
              "host": "almonium.com",
              "pathPrefix": "/d/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/almonium-logo.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      "expo-apple-authentication",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/almonium-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F9F6F5",
          "dark": {
            "backgroundColor": "#14111A"
          }
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.33380019461-pcob2v5bj8ad1bh6s6kdvc502f1duuld"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "extraPods": [
              {
                "name": "GoogleUtilities",
                "modular_headers": true
              },
              {
                "name": "RecaptchaInterop",
                "modular_headers": true
              }
            ]
          }
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "db1f6412-0a43-442d-bdc6-b3de66f929c7"
      }
    },
    "owner": "almonium",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/db1f6412-0a43-442d-bdc6-b3de66f929c7"
    }
  }
}
